{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "To put this simply, I made this mod for my siblings to be able to learn English while playing Minecraft. It makes it possible to display 2 languages at the same time in the game.",
  "authors": [
    "fabbe50"
  ],
  "contact": {
    "homepage": "https://fabbe50.com/modlink/langsplit/",
    "sources": "https://github.com/fabbe50/LangSplit",
    "issues": "https://github.com/fabbe50/LangSplit/issues"
  },
  "license": "GPL-3.0-or-later",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.fabbe50.langsplit.platform.fabric.LangsplitFabric"
    ],
    "modmenu": [
      "com.fabbe50.langsplit.platform.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "langsplit.mixins.json"
  ],
  "accessWidener": "langsplit.ct",
  "custom": {
    "modmenu:clientsideOnly": true,
    "links": {
      "modmenu.discord": "https://discord.gg/nHck2RKaJ3"
    }
  },
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "${minecraft}",
    "fabric-api": "*",
    "cloth-config2": ">=${cloth}"
  }
}
